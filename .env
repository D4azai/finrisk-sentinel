# Logging Configuration (ENTERPRISE GRADE)
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Non-blocking logging (async-safe): true or false
LOG_USE_QUEUE=true

# HMAC key for deterministic symbol obfuscation (optional)
# To generate: python -c "from services.logging_crypto import generate_hmac_key; print(generate_hmac_key())"
# Format: base64, hex, or raw string
LOG_HMAC_KEY=

# Fernet key for reversible encryption of sensitive data (optional)
# To generate: python -c "from services.logging_crypto import generate_fernet_key; print(generate_fernet_key())"
# Format: base64 (44 chars), hex (64 chars), or raw 32-byte string
# When set, symbols are both hashed AND encrypted in logs
LOG_FERNET_KEY=

# Environment: development or production (for logging config)
ENVIRONMENT=development