# Local Compose only. Generate credentials with scripts/init_local_env.py.
POSTGRES_PASSWORD=replace-with-generated-local-password
FINRISK_ENVIRONMENT=development
FINRISK_ALLOW_INSECURE_LOCAL=true
FINRISK_KAFKA_BOOTSTRAP_SERVERS=kafka:9092
FINRISK_KAFKA_SECURITY_PROTOCOL=PLAINTEXT
FINRISK_DATABASE_URL=postgresql://finrisk:replace-with-generated-local-password@postgres:5432/finrisk
MARKET_DATA_SYMBOLS=["btcusdt","ethusdt"]
# init_local_env.py also generates separate API credentials and local issuer settings.
# For an existing local environment, run uv run python scripts/init_api_env.py.
# Opt in only for the fictional catalog/quote fixtures; forbidden in production.
API_ALLOW_DEMO_MARKET_DATA=false
API_ENABLE_PAPER_TRADING=false
API_ENABLE_DEV_LOGIN=false
# Auth0 API settings. The issuer must include its trailing slash.
API_OIDC_AUDIENCE=https://api.finrisk.app
API_REQUIRED_SCOPE=finrisk:access
# Optional public OIDC client. Register the exact /auth/callback redirect with your provider.
# Set all four together; disable development login. No browser client secret is used.
API_BROWSER_CLIENT_ID=
API_BROWSER_AUTHORIZATION_URL=
API_BROWSER_TOKEN_URL=
API_BROWSER_REDIRECT_URI=
# Optional provider-specific audience authorization parameter.
API_BROWSER_AUTH_AUDIENCE=
